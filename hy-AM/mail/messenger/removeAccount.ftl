remove-account-dialog-title = Հեռացնել հաշիվը և տվյալը
remove-account-dialog-accept =
    .label = Հեռացնել
    .accesskey = Հ
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Հեռացնե՞լ "{ $accountName }" հաշիվը։
remove-account-checkbox =
    .label = Հեռացնել հաշվի տեղեկությունը
    .accesskey = հ
remove-account-description = Հեռացնում է միայն { -brand-short-name } -ի գիտելիքները այս հաշվի մասին: Սպասարկչի և հաշվի վրա չի ազդում:
remove-data-checkbox =
    .label = Հեռացնել հաղորդագրության տվյալները
    .accesskey = d
remove-chat-data-checkbox =
    .label = Հեռացնել զրույցի տվյալները
    .accesskey = d
remove-data-local-account-description = Տեղական սկավառակից հեռացնում է այս հաշվի հետ կապված բոլոր հաղորդագրությունները, պանակները և զտիչները: Սա չի ազդում որոշ հաղորդագրությունների վրա, որոնք դեռ կարող են պահվել սպասարկչում: Մի ընտրեք սա, եթե դուք պատրաստվում եք պահեսացնել տեղական տվյալները կամ դրանք կրկին օգտագործել { -brand-short-name } ֊ում ավելի ուշ:
remove-data-server-account-description = Տեղական սկավառակից հեռացնում է այս հաշվի հետ կապված բոլոր հաղորդագրությունները, պանակները և զտիչները: Ձեր հաղորդագրությունները և պանակները դեռ պահվում են սպասարկչի վրա:
remove-data-chat-account-description = Տեղական սկավառակում հեռացնում է այս հաշվի համար պահվող զրույցների բոլոր տեղեկամատյանները:
show-data-button =
    .label = Ցուցադրել տվյալների գտնվելու վայրը
    .accesskey = S
