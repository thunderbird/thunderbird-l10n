remove-account-dialog-title = Hiqni Llogari dhe Të dhëna
remove-account-dialog-accept =
    .label = Hiqe
    .accesskey = H
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Jeni i sigurt se doni të hiqet llogaria "{ $accountName }"?
remove-account-checkbox =
    .label = Hiqni hollësi llogarie
    .accesskey = a
remove-account-description = Heq vetëm dijeninë e { -brand-short-name }-it mbi këtë llogari. Nuk prek vetë llogarinë te shërbyesi.
remove-data-checkbox =
    .label = Hiq të dhëna mesazhi
    .accesskey = d
remove-chat-data-checkbox =
    .label = Hiq të dhëna bisede
    .accesskey = d
remove-data-local-account-description = Heq nga disku juaj vendor krejt mesazhet, dosjet dhe filtrat përshoqëruar kësaj llogarie. Kjo nuk prej disa mesazhe të cilët në fakt mund të jenë mbajtur ende në shërbyes. Mos e zgjidhni këtë mundësi, nëse keni në plan të arkivoni të dhënat vendore ose t’i ripërdorni më vonë në { -brand-short-name }.
remove-data-server-account-description = Heq nga disku juaj vendor krejt mesazhet, dosjet dhe filtrat përshoqëruar kësaj llogarie. Mesazhet dhe dosjet tuaja mbahen ende në shërbyes.
remove-data-chat-account-description = Heq nga disku juaj vendor krejt regjistrat e bisedave përshoqëruar kësaj llogarie.
show-data-button =
    .label = Shfaq vendndodhje të dhënash
    .accesskey = S
