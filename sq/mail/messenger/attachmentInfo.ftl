## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Ruaje Bashkëngjitjen
attachment-save-all-dialog-title = Ruaji Tërë Bashkëngjitjet
attachment-detach-dialog-title = Shqite Bashkëngjitjen
attachment-detach-all-dialog-title = Shqiti Krejt Bashkëngjitjet
attachment-save-failed = S’arrihet të ruhet bashkëngjitja. Ju lutemi, kontrolloni emrin tuaj të kartelës dhe riprovoni më vonë.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = Ka tashmë një { $filename }. Doni ta zëvendësoni?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Bashkëngjitjet vijuese do të fshihen përgjithmonë nga ky mesazh:
    { $attachments }
    Ky veprim s’mund të zhbëhet. Doni të vazhdohet?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Bashkëngjitjet vijuese janë ruajtur me sukses dhe tani do të fshihen përgjithmonë prej këtij mesazhi:
    { $attachments }
    Ky veprim s’mund të zhbëhet. Doni të vazhdohet?
attachment-empty =
    Kjo bashkëngjitje duket e zbrazët.
    Ju lutemi, pyetni personin që jua dërgoi.
    Programet antivirus ose "firewall"-et e shoqërisë shpesh mund t’i shkatërrojnë bashkëngjitjet.
attachment-external-not-found = Kjo bashkëngjitje kartele të shkëputur apo lidhjeje nuk gjendet ose nuk kapet më dot te kjo vendndodhje.
