compact-folders-dialog-title = Saspiestās mapes
compact-dialog =
    .buttonlabelaccept = Saspiest tagad
    .buttonlabelcancel = Atgādināt vēlāk
    .buttonlabelextra1 = Uzzināt vairāk…
    .buttonaccesskeyaccept = C
    .buttonaccesskeycancel = R
    .buttonaccesskeyextra1 = L
# Variables:
#  $data (String): The amount of space to be freed, formatted byte, MB, GB, etc., based on the size.
compact-dialog-message = { -brand-short-name } ir jāveic regulāra failu apkope, lai uzlabotu jūsu pasta mapju veiktspēju. Tas atjaunos { $data } diska vietas, nemainot jūsu ziņojumus. Lai ļautu { -brand-short-name } to darīt automātiski turpmāk bez jautāšanas, atzīmējiet tālāk esošo izvēles rūtiņu, pirms izvēlaties “{ compact-dialog.buttonlabelaccept }”.
compact-dialog-never-ask-checkbox =
    .label = Turpmāk mapes automātiski saspiest
    .accesskey = a
