## These strings are shown in a desktop notification after the user requests we resend a verification email.

sync-verification-sent-title = Apstiprinājuma epasts nosūtīts
# Variables:
# $userEmail (String) - Email address of the account used for sync.
sync-verification-sent-body = Apstiprināšanas saite nosūtīta uz { $userEmail }.
sync-verification-not-sent-title = Apstiprinājumu neizdevās nosūtīt
sync-verification-not-sent-body = Mums šobrīd neizdodas nosūtīt apliecinājuma e-pasta ziņojumu, tāpēc lūgums vēlāk mēģināt vēlreiz.

## These strings are shown in a confirmation dialog when the user chooses to sign out.

sync-signout-dialog-title = Vai izrakstīties no konta?
sync-signout-dialog-body = Vienādotie dati paliks Tavā kontā.
sync-signout-dialog-button = Izrakstīties

## These strings are shown in a confirmation dialog when the user chooses to stop syncing.

sync-disconnect-dialog-title = Atvienoties?
sync-disconnect-dialog-body = { -brand-product-name } pārtrauks datu vienādošanu, taču neizdzēsīs šajā ierīcē saglabātos datus.
sync-disconnect-dialog-button = Atvienoties
