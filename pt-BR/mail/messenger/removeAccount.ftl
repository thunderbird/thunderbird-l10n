remove-account-dialog-title = Remover Conta e Dados armazenados
remove-account-dialog-accept =
    .label = Remover
    .accesskey = R
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Tem certeza que quer remover a conta "{ $accountName }"?
remove-account-checkbox =
    .label = Remover informações da conta
    .accesskey = a
remove-account-description = Remover somente o conhecimento do { -brand-short-name } desta conta. Isso não afeta a conta no servidor.
remove-data-checkbox =
    .label = Remover mensagem
    .accesskey = d
remove-chat-data-checkbox =
    .label = Remover dados da conversa
    .accesskey = r
remove-data-local-account-description = Remove todas as mensagens, pastas e filtros associados a esta conta do seu disco local. Isso não afeta algumas mensagens que podem estar mantidas no servidor. Não escolha esta opção se planeja arquivar os dados locais ou reusar no { -brand-short-name } mais tarde.
remove-data-server-account-description = Remover todas as mensagens, pastas e filtros associados a esta conta do seu disco local. Suas mensagens e pastas serão mantidas no servidor.
remove-data-chat-account-description = Remover todos os registros de conversas desta conta armazenados no disco local.
show-data-button =
    .label = Mostrar localização
    .accesskey = S
