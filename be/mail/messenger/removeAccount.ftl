remove-account-dialog-title = Выдаленне уліковага запісу і дадзеных
remove-account-dialog-accept =
    .label = Выдаліць
    .accesskey = В
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Вы сапраўды жадаеце выдаліць уліковы запіс "{ $accountName }"?
remove-account-checkbox =
    .label = Выдаліць звесткі ўліковага запісу
    .accesskey = у
remove-account-description = Выдаляе гэты ўліковы запіс толькі з памяці { -brand-short-name }. Не закранае сам уліковы запіс на серверы.
remove-data-checkbox =
    .label = Выдаліць дадзеныя паведамленняў
    .accesskey = д
remove-chat-data-checkbox =
    .label = Выдаліць дадзеныя размовы
    .accesskey = д
remove-data-local-account-description = Выдаляе ўсе паведамленні, папкі і фільтры, звязаныя з гэтым уліковым запісам, з вашага лакальнага дыска. Гэта не закране некаторыя паведамленні, якія могуць усё яшчэ захоўвацца на серверы. Не выбірайце гэта, калі вы плануеце архіваваць лакальныя дадзеныя ці ізноў выкарыстоўваць іх у { -brand-short-name } пазней.
remove-data-server-account-description = Выдаляе ўсе паведамленні, папкі і фільтры, звязаныя з гэтым уліковым запісам, з вашага лакальнага дыска. Вашы паведамленні і папкі ўсё яшчэ захоўваюцца на серверы.
remove-data-chat-account-description = Выдаляе ўсе логі размоў, захаваныя для гэтага ўліковага запісу на вашым лакальным дыску.
show-data-button =
    .label = Паказаць размяшчэнне дадзеных
    .accesskey = П
