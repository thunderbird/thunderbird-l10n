remove-account-dialog-title = Paskyros ir duomenų šalinimas
remove-account-dialog-accept =
    .label = Pašalinti
    .accesskey = š
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Ar tikrai norite pašalinti paskyrą „{ $accountName }“?
remove-account-checkbox =
    .label = Pašalinti paskyros duomenis
    .accesskey = p
remove-account-description = Pašalinti tik „{ -brand-short-name }" turimą informaciją apie šią paskyrą. Serveryje laikomi paskyros duomenys nebus paliesti.
remove-data-checkbox =
    .label = Pašalinti elektroninių laiškų duomenis
    .accesskey = d
remove-chat-data-checkbox =
    .label = Pašalinti pokalbio duomenis
    .accesskey = d
remove-data-local-account-description = Pašalinti visus laiškus, aplankus ir filtrus, susietus su šia paskyra iš kompiuterio disko. Laiškai, vis dar esantys serveryje, nebus paliesti. Nesirinkite šio varianto, jei planuojate archyvuoti turimus duomenis, arba vėliau juos vėl naudoti su „{ -brand-short-name }“.
remove-data-server-account-description = Pašalinti visus laiškus, aplankus ir filtrus, susietus su šia paskyra iš kompiuterio disko. Laiškai ir aplankai, esantys serveryje, nebus paliesti.
remove-data-chat-account-description = Pašalina visus pokalbių įrašus, išsaugotus šios paskyros vietiniame diske.
show-data-button =
    .label = Rodyti duomenų vietą diske
    .accesskey = R
