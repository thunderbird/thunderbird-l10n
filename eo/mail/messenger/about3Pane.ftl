## Confirmation prompts shown before deleting a folder.

folder-delete-title = Forigi mesaĝujon
# Button label for the folder deletion prompt. The ampersand marks the access
# key, as required by the prompt service.
folder-delete-button = &Forigi mesaĝujon
# Variables:
#   $name (String) - Name of the folder being deleted.
folder-delete-confirm = Ĉu vi certe volas forigi la mesaĝujon “{ $name }”?
# Shown instead of folder-delete-confirm when the folder cannot be moved to a
# trash folder, and so will be destroyed straight away.
# Variables:
#   $name (String) - Name of the folder being deleted.
folder-delete-no-trash-confirm = Forigi tiun ĉi mesaĝujon estas neinversigebla kaj ĉiuj mesaĝoj kaj submesaĝujoj en ĝi ankaŭ estos forigitaj. Ĉu vi certe volas forigi la mesaĝujon “{ $name }”?
# Variables:
#   $name (String) - Name of the folder being deleted.
folder-delete-filter-confirm = Per forigi la mesaĝujon “{ $name }”, ĉiuj filtriloj ligitaj al ĝi malaktiviĝos. Ĉu vi certe volas forigi la mesaĝujon?
