remove-account-dialog-title = Видалити обліковий запис і дані
remove-account-dialog-accept =
    .label = Видалити
    .accesskey = В
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Ви справді хочете видалити обліковий запис "{ $accountName }"?
remove-account-checkbox =
    .label = Видалити інформацію облікового запису
    .accesskey = о
remove-account-description = Видаляє лише знання { -brand-short-name } про цей обліковий запис. Не зачіпає власне обліковий запис на сервері.
remove-data-checkbox =
    .label = Видалити дані повідомлень
    .accesskey = п
remove-chat-data-checkbox =
    .label = Видалити дані розмови
    .accesskey = л
remove-data-local-account-description = Видаляє всі повідомлення, теки й фільтри, що пов'язані з цим обліковим записом з вашого локального диска. Не зачіпає деякі повідомлення, що все ще можуть зберігатися на сервері. Не обирайте це, якщо ви плануєте архівувати локальні дані чи використовувати їх повторно в { -brand-short-name } згодом.
remove-data-server-account-description = Видаляє всі повідомлення, теки й фільтри, що пов'язані з цим обліковим записом з вашого локального диска. Ваші повідомлення й теки все ще зберігаються на сервері.
remove-data-chat-account-description = Видаляє всі розмови для цього облікового запису, що зберігаються на вашому локальному диску.
show-data-button =
    .label = Показати розташування даних
    .accesskey = к
