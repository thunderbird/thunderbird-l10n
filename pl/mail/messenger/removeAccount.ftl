remove-account-dialog-title = Usuń konto i dane
remove-account-dialog-accept =
    .label = Usuń
    .accesskey = U
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Czy na pewno usunąć konto „{ $accountName }”?
remove-account-checkbox =
    .label = Usuń informacje o koncie
    .accesskey = s
remove-account-description = Usuwa tylko informacje o koncie w programie { -brand-short-name }. Nie wpływa na konto na serwerze.
remove-data-checkbox =
    .label = Usuń dane wiadomości
    .accesskey = d
remove-chat-data-checkbox =
    .label = Usuń dane rozmów
    .accesskey = d
remove-data-local-account-description = Usuwa z lokalnego dysku wszystkie wiadomości, foldery i filtry powiązane z tym kontem. Nie wpływa na wiadomości, które mogą być nadal przechowywane na serwerze. Nie wybieraj tej opcji, jeśli planujesz archiwizować lokalne dane lub używać ich w programie { -brand-short-name } później.
remove-data-server-account-description = Usuwa z lokalnego dysku wszystkie wiadomości, foldery i filtry powiązane z tym kontem. Wiadomości i foldery będą nadal przechowywane na serwerze.
remove-data-chat-account-description = Usuwa wszystkie zapisy rozmów przechowywane dla tego konta na lokalnym dysku.
show-data-button =
    .label = Wyświetl położenie danych
    .accesskey = W
