remove-account-dialog-title = เอาบัญชีและข้อมูลออก
remove-account-dialog-accept =
    .label = เอาออก
    .accesskey = อ
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = คุณแน่ใจหรือไม่ว่าต้องการเอาบัญชี "{ $accountName }" ออก?
remove-account-checkbox =
    .label = เอาข้อมูลบัญชีออก
    .accesskey = ข
remove-account-description = เอาเฉพาะบัญชีที่ { -brand-short-name } รู้จักออกเท่านั้นโดยไม่มีผลต่อบัญชีที่อยู่บนเซิร์ฟเวอร์
remove-data-checkbox =
    .label = เอาข้อมูลข้อความออก
    .accesskey = ม
remove-chat-data-checkbox =
    .label = เอาข้อมูลการสนทนาออก
    .accesskey = ม
remove-data-local-account-description = เอาข้อความ, โฟลเดอร์ และตัวกรองทั้งหมดที่เกี่ยวข้องกับบัญชีนี้ออกจากดิสก์ในเครื่องของคุณ โดยจะไม่มีผลต่อข้อความบางส่วนซึ่งอาจยังคงถูกเก็บไว้บนเซิร์ฟเวอร์ อย่าเลือกตัวเลือกนี้หากคุณวางแผนที่จะเก็บข้อมูลในเครื่องหรือนำกลับมาใช้ใหม่ใน { -brand-short-name } ในภายหลัง
remove-data-server-account-description = เอาข้อความ, โฟลเดอร์ และตัวกรองทั้งหมดที่เกี่ยวข้องกับบัญชีนี้ออกจากดิสก์ในเครื่องของคุณ ข้อความและโฟลเดอร์ของคุณจะยังคงอยู่บนเซิร์ฟเวอร์
remove-data-chat-account-description = เอาไฟล์บันทึกการสนทนาทั้งหมดที่เก็บไว้สำหรับบัญชีนี้ออกจากดิสก์ในเครื่องของคุณ
show-data-button =
    .label = แสดงตำแหน่งที่ตั้งข้อมูล
    .accesskey = ส
