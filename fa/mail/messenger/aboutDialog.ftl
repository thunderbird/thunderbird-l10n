about-dialog-title = دربارهٔ { -brand-full-name }
release-notes-link = یادداشت‌های انتشار
# This describes the codename logo shown in the About Thunderbird dialog for the current annual release.
# Do not translate: Meadow
about-dialog-meadow-logo =
    .alt = نشان رمزنام Meadow برای { -brand-short-name }
    .title = { -brand-short-name } - رمزنام Meadow
update-internal-error = به دلیل خطای داخلی، بررسی به‌روزرسانی‌ها ممکن نیست. به‌روزرسانی‌ها در <a data-l10n-name="manual-link"/> در دسترس‌اند
update-check-for-updates-button = بررسی به‌روزرسانی‌ها
    .accesskey = ب
update-update-button = راه‌اندازی دوباره برای به‌روزرسانی { -brand-shorter-name }
    .accesskey = ر
update-checking-for-updates = در حال بررسی به‌روزرسانی‌ها…
update-downloading-message = در حال بارگیری به‌روزرسانی — <span data-l10n-name="download-status"></span>
update-applying = در حال اعمال به‌روزرسانی…
update-downloading = <img data-l10n-name="icon"/>در حال بارگیری به‌روزرسانی — <span data-l10n-name="download-status"></span>
update-failed = به‌روزرسانی ناموفق بود. <a data-l10n-name="failed-link">آخرین نگارش را بارگیری کنید</a>
update-admin-disabled = به‌روزرسانی‌ها توسط مدیر سیستم شما ازکار افتاده است
update-no-updates-found = { -brand-short-name } به‌روز است
update-other-instance-handling-updates = { -brand-short-name } در حال به‌روزرسانی توسط نمونهٔ دیگری است
update-manual = به‌روزرسانی‌ها در <a data-l10n-name="manual-link"/> در دسترس‌اند
update-unsupported = نمی‌توانید روی این سیستم به‌روزرسانی بیشتری انجام دهید. <a data-l10n-name="unsupported-link">بیشتر بدانید</a>
update-restarting = در حال راه‌اندازی دوباره…
# Variables:
#   $channel (String): description of the update channel (e.g. "release", "beta", "nightly" etc.)
channel-description = در حال حاضر در کانال به‌روزرسانی <span data-l10n-name="current-channel">{ $channel }</span> هستید.
warning-desc-version = { -brand-short-name } آزمایشی است و ممکن است ناپایدار باشد.
warning-desc-telemetry = اطلاعات دربارهٔ کارایی، سخت‌افزار، استفاده و سفارشی‌سازی‌ها را به‌طور خودکار برای { -vendor-short-name } می‌فرستد تا به بهتر شدن { -brand-short-name } کمک کند.
# Example of resulting string: 66.0.1 (64-bit)
# Variables:
#   $version (String): version of Thunderbird, e.g. 66.0.1
#   $bits (Number): bits of the architecture (32 or 64)
aboutDialog-version = { $version } ({ $bits } بیتی)
# Example of resulting string: 66.0a1 (2019-01-16) (64-bit)
# Variables:
#   $version (String): version of Thunderbird for Daily builds, e.g. 66.0a1
#   $isodate (String): date in ISO format, e.g. 2019-01-16
#   $bits (Number): bits of the architecture (32 or 64)
aboutDialog-version-nightly = { $version } ({ $isodate }) ({ $bits } بیتی)
# Example of resulting string: 131.0a1 (aarch64)
# Variables:
#   $version (String): version of Thunderbird, e.g. 66.0.1
#   $arch (String): name of the architecture (arm, aarch64, etc.)
aboutdialog-version-arch = { $version } ({ $arch })
# Example of resulting string: 131.0a1 (2024-08-27) (aarch64)
# Variables:
#   $version (String): version of Thunderbird for Daily builds, e.g. 66.0a1
#   $isodate (String): date in ISO format, e.g. 2019-01-16
#   $arch (String): name of the architecture (arm, aarch64, etc.)
aboutdialog-version-arch-nightly = { $version } ({ $isodate }) ({ $arch })
aboutdialog-update-checking-failed = بررسی به‌روزرسانی‌ها ناموفق بود.
community-experimental = <a data-l10n-name="community-exp-mozilla-link">{ -vendor-short-name }</a> یک <a data-l10n-name="community-exp-credits-link">اجتماع جهانی</a> است که با هم کار می‌کنند تا وب باز، عمومی و در دسترس همه بماند.
community-desc = { -brand-short-name } توسط <a data-l10n-name="community-mozilla-link">{ -vendor-short-name }</a> طراحی شده است؛ <a data-l10n-name="community-credits-link">اجتماع جهانی</a> که با هم کار می‌کنند تا وب باز، عمومی و در دسترس همه بماند.
about-donation = می‌خواهید کمک کنید؟ <a data-l10n-name="helpus-donate-link">اعانه دهید</a> یا <a data-l10n-name="helpus-get-involved-link">مشارکت کنید!</a>
bottom-links-license = اطلاعات مجوز
bottom-links-rights = حقوق کاربر نهایی
bottom-links-privacy = سیاست حفظ محرمانگی
