## The Enterprise Policies feature is aimed at system administrators
## who want to deploy these settings across several Thunderbird installations
## all at once. This is traditionally done through the Windows Group Policy
## feature, but the system also supports other forms of deployment.
## These are short descriptions for individual policies, to be displayed
## in the documentation section in about:policies.

policy-3rdparty = تنظیم سیاست‌هایی که WebExtensionها می‌توانند از طریق chrome.storage.managed به آن‌ها دسترسی داشته باشند.
policy-AppAutoUpdate = به‌کار گرفتن یا ازکار انداختن به‌روزرسانی خودکار برنامه.
policy-AppUpdatePin = جلوگیری از به‌روزرسانی { -brand-short-name } فراتر از نگارش مشخص‌شده.
policy-AppUpdateURL = تنظیم نشانی سفارشی به‌روزرسانی برنامه.
policy-Authentication = پیکربندی احراز هویت یکپارچه برای وبگاه‌هایی که از آن پشتیبانی می‌کنند.
policy-BackgroundAppUpdate2 = به‌کار انداختن یا ازکار انداختن به‌روزرسان پس‌زمینه.
policy-BlockAboutAddons = مسدود کردن دسترسی به مدیر برافزا‌ها (about:addons).
policy-BlockAboutConfig = مسدود کردن دسترسی به صفحهٔ about:config.
policy-BlockAboutProfiles = مسدود کردن دسترسی به صفحهٔ about:profiles.
policy-BlockAboutSupport = مسدود کردن دسترسی به صفحهٔ about:support.
policy-CaptivePortal = به‌کار انداختن یا ازکار انداختن پشتیبانی از درگاه محدودکننده.
policy-CertificatesDescription = افزودن گواهی‌ها یا استفاده از گواهی‌های داخلی.
policy-Cookies = اجازه دادن یا ندادن به وبگاه‌ها برای تنظیم کلوچک‌ها.
policy-DisableBuiltinPDFViewer = ازکار انداختن PDF.js، نمایشگر داخلی PDF در { -brand-short-name }.
policy-DisabledCiphers = ازکار انداختن رمزنگاری‌ها.
policy-DefaultDownloadDirectory = تنظیم شاخهٔ پیش‌گزیده بارگیری.
policy-DisableAppUpdate = جلوگیری از به‌روزرسانی { -brand-short-name }.
policy-DisableChat = ازکار انداختن ویژگی گپ.
policy-DisableCommunity = نمایش ندادن ویژگی‌های اجتماع در رابط کاربری (مانند اعانه، مشارکت کنید، هم‌رسانی ایده‌ها و…)
policy-DisableDataCollectionSettings = جلوگیری از تغییر تنظیمات جمع‌آوری داده توسط کاربر.
policy-DisableDefaultClientAgent = جلوگیری از هرگونه اقدام عامل کارخواه پیش‌گزیده. فقط در Windows کاربرد دارد؛ سکوهای دیگر این عامل را ندارند.
policy-DisableDeveloperTools = مسدود کردن دسترسی به ابزارهای توسعه‌دهنده.
policy-DisableFeedbackCommands = ازکار انداختن فرمان‌های ارسال بازخورد از منوی راهنما (ارسال بازخورد و گزارش وبگاه گمراه‌کننده).
policy-DisableFileLink = ازکار انداختن ویژگی Filelink.
policy-DisableForgetButton = جلوگیری از دسترسی به دکمهٔ فراموش کردن.
policy-DisableFormHistory = به خاطر نسپردن تاریخچهٔ جست‌وجو و فرم.
policy-DisableMasterPasswordCreation = اگر درست باشد، گذرواژهٔ اصلی ساخته نمی‌شود.
policy-DisableMessageForwardingFilters = جلوگیری از بازارسال خودکار پیام‌ها توسط پالایه‌های پیام.
policy-DisablePasswordReveal2 = اجازه ندادن به آشکار شدن گذرواژه‌ها در ورودهای ذخیره‌شده یا زمینه‌های گذرواژه.
policy-DisablePasswordReveal = اجازه ندادن به آشکار شدن گذرواژه‌ها در ورودهای ذخیره‌شده.
policy-DisableProfileImport = ازکار انداختن فرمان منوی درون‌ریزی داده از برنامهٔ دیگر.
policy-DisableExperimentalFeatures = ازکار انداختن ویژگی‌های آزمایشی در Thunderbird.
policy-DisableQRExport = ازکار انداختن ساختن کد QR برای برون‌ریزی تنظیمات حساب و اطلاعات ورود.
policy-DisableSafeMode = ازکار انداختن ویژگی راه‌اندازی دوباره در حالت امن. توجه: کلید Shift برای ورود به حالت امن فقط در Windows و با Group Policy قابل ازکار انداختن است.
policy-DisableSecurityBypass = جلوگیری از نادیده گرفتن برخی هشدارهای امنیتی توسط کاربر.
policy-DisableSystemAddonUpdate = جلوگیری از نصب و به‌روزرسانی برافزا‌های سیستمی توسط { -brand-short-name }.
policy-DisableTelemetry = خاموش کردن دورسنجی.
policy-DisableUpdateSettings = جلوگیری از تغییر تنظیمات به‌روزرسانی برنامه توسط کاربر.
policy-DisplayMenuBar = نمایش پیش‌گزیده نوار منو.
policy-DNSOverHTTPS = پیکربندی DNS روی HTTPS.
policy-DontCheckDefaultClient = ازکار انداختن بررسی کارخواه پیش‌گزیده هنگام راه‌اندازی.
policy-DownloadDirectory = تنظیم و قفل کردن شاخهٔ بارگیری.
# “lock” means that the user won’t be able to change this setting
policy-EnableTrackingProtection = به‌کار انداختن یا ازکار انداختن مسدودسازی محتوا و در صورت تمایل قفل کردن آن.
# “lock” means that the user won’t be able to change this setting
policy-EncryptedMediaExtensions = به‌کار انداختن یا ازکار انداختن برافزا‌های رسانهٔ رمزگذاری‌شده و در صورت تمایل قفل کردن آن.
# A “locked” extension can’t be disabled or removed by the user. This policy
# takes 3 keys (“Install”, ”Uninstall”, ”Locked”), you can either keep them in
# English or translate them as verbs.
policy-Extensions = نصب، حذف نصب یا قفل کردن برافزا‌ها. گزینهٔ Install نشانی‌ها یا مسیرها را به‌عنوان پارامتر می‌پذیرد. گزینه‌های Uninstall و Locked شناسهٔ افزونه‌ها را می‌پذیرند.
policy-ExtensionSettings = مدیریت همهٔ جنبه‌های نصب افزونه.
policy-ExtensionUpdate = به‌کار انداختن یا ازکار انداختن به‌روزرسانی خودکار افزونه‌ها.
policy-Handlers = پیکربندی برنامه‌های پیش‌گزیده رسیدگی‌کننده.
policy-HardwareAcceleration = اگر نادرست باشد، شتاب‌دهی سخت‌افزاری خاموش می‌شود.
policy-InAppNotification = به‌کار انداختن یا ازکار انداختن انواع آگاهی‌ها.
policy-InstallAddonsPermission = اجازه دادن به برخی وبگاه‌ها برای نصب برافزا‌ها.
policy-LegacyProfiles = ازکار انداختن ویژگی‌ای که برای هر نصب یک نمایهٔ جداگانه اجبار می‌کند.

## Do not translate "SameSite", it's the name of a cookie attribute.

policy-LegacySameSiteCookieBehaviorEnabled = به‌کار انداختن تنظیم پیش‌گزیده رفتار قدیمی SameSite برای کلوچک‌ها.
policy-LegacySameSiteCookieBehaviorEnabledForDomainList = بازگشت به رفتار قدیمی SameSite برای کلوچک‌ها در وبگاه‌های مشخص‌شده.

##

policy-LocalFileLinks = اجازه دادن به وبگاه‌های مشخص برای پیوند به پرونده‌های محلی.
policy-ManualAppUpdateOnly = فقط به‌روزرسانی دستی مجاز باشد و دربارهٔ به‌روزرسانی‌ها به کاربر اطلاع داده نشود.
policy-NetworkPrediction = به‌کار انداختن یا ازکار انداختن پیش‌بینی شبکه (پیش‌واکشی DNS).
policy-OfferToSaveLogins = اجبار تنظیمی که به { -brand-short-name } اجازه می‌دهد پیشنهاد به خاطر سپردن ورودها و گذرواژه‌ها را بدهد. هر دو مقدار درست و نادرست پذیرفته می‌شوند.
policy-OfferToSaveLoginsDefault = تنظیم مقدار پیش‌گزیده برای اجازه دادن به { -brand-short-name } برای پیشنهاد به خاطر سپردن ورودها و گذرواژه‌ها. هر دو مقدار درست و نادرست پذیرفته می‌شوند.
policy-OverrideFirstRunPage = بازنویسی صفحهٔ نخستین اجرا؛ اگر می‌خواهید صفحهٔ نخستین اجرا ازکار بیفتد، این سیاست را خالی بگذارید.
policy-OverridePostUpdatePage = بازنویسی صفحهٔ «چه چیزهایی تازه است» پس از به‌روزرسانی. اگر می‌خواهید صفحهٔ پس از به‌روزرسانی ازکار بیفتد، این سیاست را خالی بگذارید.
policy-PasswordManagerEnabled = به‌کار انداختن ذخیرهٔ گذرواژه‌ها در مدیر گذرواژه.
# PDF.js and PDF should not be translated
policy-PDFjs = ازکار انداختن یا پیکربندی PDF.js، نمایشگر داخلی PDF در { -brand-short-name }.
policy-Permissions2 = پیکربندی مجوزهای دوربین، میکروفون، مکان، آگاهی‌ها و پخش خودکار.
policy-Preferences = تنظیم و قفل کردن مقدار زیرمجموعه‌ای از ترجیحات.
policy-PrimaryPassword = الزام یا جلوگیری از استفاده از گذرواژهٔ اصلی.
policy-PromptForDownloadLocation = هنگام بارگیری بپرسد پرونده‌ها کجا ذخیره شوند.
policy-Proxy = پیکربندی تنظیمات پیشکار.
policy-RequestedLocales = تنظیم فهرست زبان‌های درخواستی برنامه به ترتیب اولویت.
policy-SanitizeOnShutdown2 = پاک کردن داده‌های پیمایش هنگام خاموش شدن.
policy-SearchEngines = پیکربندی تنظیمات موتور جست‌وجو. این سیاست فقط در نگارش پشتیبانی گسترده (ESR) در دسترس است.
policy-SearchSuggestEnabled = به‌کار انداختن یا ازکار انداختن پیشنهادهای جست‌وجو.
policy-SecurityDevices2 = افزودن یا حذف پودمان‌های PKCS #11.
policy-SSLVersionMax = تنظیم حداکثر نگارش SSL.
policy-SSLVersionMin = تنظیم حداقل نگارش SSL.
policy-SupportMenu = افزودن یک مورد پشتیبانی سفارشی به منوی راهنما.
policy-UserMessaging = برخی پیام‌ها به کاربر نشان داده نشوند.
# “format” refers to the format used for the value of this policy.
policy-WebsiteFilter = مسدود کردن بازدید از وبگاه‌ها. برای جزئیات بیشتر دربارهٔ قالب، مستندات را ببینید.
