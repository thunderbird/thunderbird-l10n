otr-auth =
    .buttonlabelaccept = تأیید
    .title = تأیید هویت مخاطب
# Variables:
#   $name (String) - the screen name of a chat contact person
auth-title = تأیید هویت { $name }
# Variables:
#   $own_name (String) - the user's own screen name
auth-your-fp-value = اثر انگشت شما، { $own_name }:
# Variables:
#   $their_name (String) - the screen name of a chat contact
auth-their-fp-value = اثر انگشت { $their_name }:
auth-question-received = این پرسشی است که مخاطب شما پرسیده است:
auth-yes =
    .label = بله
auth-no =
    .label = خیر
auth-verified = تأیید کرده‌ام که این واقعاً اثر انگشت درست است.
auth-manual-verification = تأیید دستی اثر انگشت
auth-question-and-answer = پرسش و پاسخ
auth-shared-secret = راز مشترک
auth-manual-verification-label =
    .label = { auth-manual-verification }
auth-question-and-answer-label =
    .label = { auth-question-and-answer }
auth-shared-secret-label =
    .label = { auth-shared-secret }
auth-manual-instruction = با طرف گفت‌وگوی مورد نظر خود از طریق کانال احراز هویت‌شدهٔ دیگری، مانند رایانامهٔ امضاشده با OpenPGP یا تلفن، تماس بگیرید. باید اثر انگشت‌هایتان را به یکدیگر بگویید. (اثر انگشت یک جمع‌آزمایی است که کلید رمزگذاری را شناسایی می‌کند.) اگر اثر انگشت مطابقت داشت، در پنجرهٔ زیر مشخص کنید که اثر انگشت را تأیید کرده‌اید.
auth-how = می‌خواهید هویت مخاطب خود را چگونه تأیید کنید؟
auth-qa-instruction = به پرسشی فکر کنید که پاسخش را فقط شما و مخاطبتان می‌دانید. پرسش و پاسخ را وارد کنید و سپس صبر کنید تا مخاطبتان پاسخ را وارد کند. اگر پاسخ‌ها یکسان نباشند، ممکن است کانال ارتباطی‌ای که استفاده می‌کنید زیر نظر باشد.
auth-secret-instruction = به رازی فکر کنید که فقط شما و مخاطبتان می‌دانید. برای تبادل راز از همان اتصال اینترنت استفاده نکنید. راز را وارد کنید و سپس صبر کنید تا مخاطبتان آن را وارد کند. اگر رازها یکسان نباشند، ممکن است کانال ارتباطی‌ای که استفاده می‌کنید زیر نظر باشد.
auth-question = یک پرسش وارد کنید:
auth-answer = پاسخ را وارد کنید (حساس به بزرگی و کوچکی حروف):
auth-secret = راز را وارد کنید:
