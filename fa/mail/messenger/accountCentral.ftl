import-paragraph2 = { -brand-short-name } به شما امکان می‌دهد پیام‌های رایانامه، مدخل‌های دفترچهٔ نشانی، اشتراک‌های خوراک، تنظیمات و/یا پالایه‌ها را از برنامه‌های رایانامهٔ دیگر و قالب‌های رایج دفترچهٔ نشانی درون‌ریزی کنید.
