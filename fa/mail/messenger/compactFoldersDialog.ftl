compact-folders-dialog-title = فشرده‌سازی پوشه‌ها
compact-dialog =
    .buttonlabelaccept = فشرده‌سازی هم‌اکنون
    .buttonlabelcancel = بعداً یادآوری کن
    .buttonlabelextra1 = بیشتر بدانید…
    .buttonaccesskeyaccept = ف
    .buttonaccesskeycancel = ب
    .buttonaccesskeyextra1 = ی
# Variables:
#  $data (String): The amount of space to be freed, formatted byte, MB, GB, etc., based on the size.
compact-dialog-message = { -brand-short-name } برای بهبود کارایی پوشه‌های رایانامهٔ شما باید به‌طور منظم پرونده‌ها را نگه‌داری کند. این کار بدون تغییر پیام‌هایتان { $data } از فضای دیسک را آزاد می‌کند. برای اینکه { -brand-short-name } در آینده بدون پرسیدن این کار را خودکار انجام دهد، پیش از انتخاب «{ compact-dialog.buttonlabelaccept }» کادر زیر را علامت بزنید.
compact-dialog-never-ask-checkbox =
    .label = فشرده‌سازی خودکار پوشه‌ها در آینده
    .accesskey = خ
