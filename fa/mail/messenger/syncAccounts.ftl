## These strings are shown in a desktop notification after the user requests we resend a verification email.

sync-verification-sent-title = تأیید فرستاده شد
# Variables:
# $userEmail (String) - Email address of the account used for sync.
sync-verification-sent-body = پیوند تأیید به { $userEmail } فرستاده شد.
sync-verification-not-sent-title = ارسال تأیید ممکن نیست
sync-verification-not-sent-body = در حال حاضر نمی‌توانیم رایانامهٔ تأیید بفرستیم، لطفاً بعداً دوباره تلاش کنید.

## These strings are shown in a confirmation dialog when the user chooses to sign out.

sync-signout-dialog-title = از حساب خارج می‌شوید؟
sync-signout-dialog-body = داده‌های همگام‌شده در حساب شما باقی می‌مانند.
sync-signout-dialog-button = خروج

## These strings are shown in a confirmation dialog when the user chooses to stop syncing.

sync-disconnect-dialog-title = قطع اتصال؟
sync-disconnect-dialog-body = { -brand-product-name } همگام‌سازی را متوقف می‌کند، اما هیچ‌یک از داده‌های شما را روی این دستگاه حذف نمی‌کند.
sync-disconnect-dialog-button = قطع اتصال
