## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Tiyak Taqoj
attachment-save-all-dialog-title = Keyak Ronojel Taqoj
attachment-detach-dialog-title = Tik'am el Taqoj
attachment-detach-all-dialog-title = Kek'am el Ronojel Taqoj
attachment-save-failed = K'ayew chi niyak ri taqoj. Tinik'öx rub'i' yakb'äl k'a ri' titojtob'ëx chik.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = { $filename } k'o chik. ¿La nawajo' najalwachij?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Re taq taqoj re' xkeyuj el pa re rutzijol re':
    { $attachments }
    Man tikirel ta nijal re samaj re'. ¿La k'a nasamajij qa?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Re taq taqoj re' ütz xeyak, wakami xkeyuj el pa re rutzijol re':
    { $attachments }
    Man tikirel ta nijal re samaj re'. ¿La k'a nasamajij qa?
attachment-empty =
    Achi'el kowöl re taqoj re'.
    Tanik'oj rik'in ri winäq xtaqo chawe.
    Jutaqil ri ajto'onel nimamoloj taq chupuq'aq' o ri taq chapöy chikopil yekiyüj ri taq taqoj.
