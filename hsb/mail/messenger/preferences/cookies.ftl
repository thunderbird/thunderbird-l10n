#   $count - the number selected cookies
remove-selected-cookies =
    .label =
        { $count ->
            [one] { $count } wubrany wotstronić
            [two] { $count } wubranej wotstronić
            [few] { $count } wubrane wotstronić
           *[other] { $count } wubranych wotstronić
        }
