# Instant messaging account status window for Thunderbird
accounts-window-title = Status for chat
account-manager-add-account =
    .label = { add-account-label }
    .accesskey = A
account-manager-close =
    .label = Luk
    .accesskey = L
account-manager-close-command =
    .key = a
# This title must be short, displayed with a big font size
account-manager-no-account-title = Ingen eksisterende konto
account-manager-no-accounts-description = Klik på knappen { add-account-label } og lad { -brand-short-name } føre dig gennem processen med at konfigurere en.
account-auto-sign-on =
    .label = Opret forbindelse ved start
    .accesskey = s
account-connect =
    .label = Opret forbindelse
    .accesskey = O
account-disconnect =
    .label = Afbryd
    .accesskey = A
account-edit =
    .label = Egenskaber
    .accesskey = E
account-cancel-reconnection =
    .label = Fortryd genopret forbindelse
    .accesskey = F
account-copy-debug-log =
    .label = Kopier debug-log
    .accesskey = K
account-connecting =
    .value = Forbinder…
account-disconnecting =
    .value = Afbryder…
account-disconnected =
    .value = Ikke forbundet
add-account-label = Tilføj konto
