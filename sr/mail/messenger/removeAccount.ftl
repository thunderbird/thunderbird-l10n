remove-account-dialog-title = Уклони налог и податке
remove-account-dialog-accept =
    .label = Уклони
    .accesskey = У
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Да ли сте сигурни да желите да уклоните налог "{ $accountName }"?
remove-account-checkbox =
    .label = Уклони податке налога
    .accesskey = а
remove-account-description = Уклања само знање { -brand-short-name }-а о овом налогу. Не мења сам налог на серверу.
remove-data-checkbox =
    .label = Уклони податке поруке
    .accesskey = д
remove-chat-data-checkbox =
    .label = Уклони податке о разговорима
    .accesskey = д
remove-data-local-account-description = Уклања све поруке, фасцикле и филтере везане за овај налог на вашем локалном диску. Ово не захвата неке поруке које и даље могу остати на серверу. Не бирајте ово уколико планирате да архивирате локалне податке и да их поново искористите касније у { -brand-short-name }-у.
remove-data-server-account-description = Уклања све поруке, фасцикле и филтере везане за овај налог на вашем локалном диску. Ваше поруке и фасцикле ће и даље бити на серверу.
remove-data-chat-account-description = Уклања све сачуване записе разговора на овом налогу, са вашег локалног диска.
show-data-button =
    .label = Прикажи место података
    .accesskey = с
