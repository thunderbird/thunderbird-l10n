remove-account-dialog-title = Премахване на профила и данните му
remove-account-dialog-accept =
    .label = Премахване
    .accesskey = п
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Сигурни ли сте, че искате да премахнете профила за  „{ $accountName }“?
remove-account-checkbox =
    .label = Премахване на данните за профила
    .accesskey = д
remove-account-description = Премахва само информацията за сметката от { -brand-short-name }. Сметката на сървъра остава незасегната.
remove-data-checkbox =
    .label = Премахване на съобщенията
    .accesskey = с
remove-chat-data-checkbox =
    .label = Премахване на разговорите
    .accesskey = р
remove-data-local-account-description = Премахва всички съобщения, папки и филтри свързани с тази сметка от местния диск. Съобщенията, останали на сървъра няма да бъдат засегнати. Не избирайте тази възможност ако планирате да правите архив на местните данни или по-късно да ги преизползвате в { -brand-short-name }.
remove-data-server-account-description = Премахва всички съобщения, папки и филтри свързани с тази сметка от местния диск. Папките и съобщенията остават на сървъра.
remove-data-chat-account-description = Премахва всички журнали от разговорите съхранени за тази сметка от местния диск.
show-data-button =
    .label = Папка с данните
    .accesskey = п
