remove-account-dialog-title = Hapus Akun dan Data
remove-account-dialog-accept =
    .label = Hapus
    .accesskey = R
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Yakin akan menghapus akun "{ $accountName }"?
remove-account-checkbox =
    .label = Hapus informasi akun
    .accesskey = a
remove-account-description = Hanya menghapuspengetahuan dan { -brand-short-name }'s akun ini. Tidak memengaruhi akun itu sendiri di server.
remove-data-checkbox =
    .label = Hapus data pesan
    .accesskey = d
remove-chat-data-checkbox =
    .label = Hapus data percakapan
    .accesskey = d
remove-data-local-account-description = Hapus semua pesan, folder dan filter yang dikaitkan dengan akun ini dari disk lokal Anda. Hal ini tidak memengaruhi beberapa pesan yang mungkin masih tersimpan di server. Jangan memilih ini jika Anda berencana mengarsipkan data lokal atau menggunakannya kembali di { -brand-short-name } nanti.
remove-data-server-account-description = Hapus semua pesan, folder dan filter yang dikaitkan dengan akun ini dari disk lokal Anda. Pesan dan folder Anda masih disimpan di server.
remove-data-chat-account-description = Menghapus semua log percakapan yang disimpan untuk akun ini pada disk lokal Anda.
show-data-button =
    .label = Tampilkan data lokasi
    .accesskey = S
