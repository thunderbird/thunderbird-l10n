remove-account-dialog-title = Thoir air falbh an cunntas is an dàta
remove-account-dialog-accept =
    .label = Thoir air falbh
    .accesskey = T
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = A bheil thu cinnteach gu bheil thu airson an cunntas “{ $accountName }” a thoirt air falbh?
remove-account-checkbox =
    .label = Thoir air falbh fiosrachadh a’ chunntais
    .accesskey = a
remove-account-description = Bheir seo air falbh am fiosrachadh aig { -brand-short-name } mun chunntas seo. Cha bhi buaidh air a’ chunntas fhèin air an fhrithealaiche.
remove-data-checkbox =
    .label = Thoir air falbh dàta nan teachdaireachdan
    .accesskey = d
remove-chat-data-checkbox =
    .label = Thoir air falbh dàta nan còmhradh
    .accesskey = d
remove-data-local-account-description = Bheir seo air falbh gach teachdaireachd, pasgan is criathrag a tha co-cheangailte ris a’ chunntas seo on diosg ionadail agad. Cha bhi buaidh air cuid dhe na teachdaireachdan a dh’fhaodadh a bhith air an fhrithealaiche. Na dèan seo ma tha thu am beachd an an dàta ionadail a chur ann an tasg-lann no a chleachdadh a-rithist ann an { -brand-short-name } uaireigin eile.
remove-data-server-account-description = Bheir seo air falbh gach teachdaireachd, pasgan is criathrag a tha co-cheangailte ris a’ chunntas seo on diosg ionadail agad.Bidh na teachdaireachdan is pasganan air an fhrithealaiche fhathast.
remove-data-chat-account-description = Thoir air falbh gach loga de chòmhraidhean a chaidh a stòradh mu choinneamh a’ chunntais seo air an diosga ionadail agad.
show-data-button =
    .label = Seall ionad an dàta
    .accesskey = S
