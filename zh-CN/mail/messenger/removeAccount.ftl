remove-account-dialog-title = 移除账户和数据
remove-account-dialog-accept =
    .label = 移除
    .accesskey = R
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = 您确定要移除账户“{ $accountName }”吗？
remove-account-checkbox =
    .label = 移除账户信息
    .accesskey = a
remove-account-description = 只移除 { -brand-short-name } 记录的此账户的信息。不会影响服务器上的它的数据。
remove-data-checkbox =
    .label = 移除消息数据
    .accesskey = d
remove-chat-data-checkbox =
    .label = 移除会话数据
    .accesskey = d
remove-data-local-account-description = 在您的本地磁盘上移除此账户相关的所有消息、文件夹和过滤器。这不会影响服务器上可能还保留的一些消息。如果您计划将本地数据留作存档，或者不久后仍使用 { -brand-short-name }，请不要选择此选项。
remove-data-server-account-description = 在您的本地磁盘上移除此账户相关的所有消息、文件夹和过滤器。您的消息和文件夹仍在服务器上保存。
remove-data-chat-account-description = 移除本地磁盘上为此账户存储的所有会话记录。
show-data-button =
    .label = 显示数据位置
    .accesskey = S
