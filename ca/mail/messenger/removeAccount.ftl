remove-account-dialog-title = Suprimeix el compte i les dades
remove-account-dialog-accept =
    .label = Suprimeix
    .accesskey = r
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Esteu segur que voleu eliminar el compte «{ $accountName }»?
remove-account-checkbox =
    .label = Suprimeix la informació del compte
    .accesskey = f
remove-account-description = Se suprimeix el compte únicament del { -brand-short-name }. No afecta el compte en el servidor.
remove-data-checkbox =
    .label = Suprimeix les dades de missatges
    .accesskey = d
remove-chat-data-checkbox =
    .label = Elimina les dades de les converses
    .accesskey = d
remove-data-local-account-description = Suprimeix del disc local tots els missatges, carpetes i filtres associats a aquest compte. Això no afecta alguns missatges, que poden romandre al servidor. No seleccioneu aquesta acció si teniu planificat arxivar les dades locals o tornar-les a utilitzar amb el { -brand-short-name } més endavant.
remove-data-server-account-description = Suprimeix del disc local tots els missatges, carpetes i filtres associats a aquest compte. Els vostres missatges i carpetes romandran al servidor.
remove-data-chat-account-description = Elimina tots els registres de converses d'aquest compte desats al disc local.
show-data-button =
    .label = Mostra la ubicació de les dades
    .accesskey = M
