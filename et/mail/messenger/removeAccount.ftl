remove-account-dialog-title = Konto ja selle andmete eemaldamine
remove-account-dialog-accept =
    .label = Eemalda
    .accesskey = E
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Kas oled kindel, et soovid eemaldada konto "{ $accountName }"?
remove-account-checkbox =
    .label = Eemaldatakse konto info
    .accesskey = k
remove-account-description = Eemaldatakse vaid { -brand-short-name }i teadmised sellest kontost. See ei mõjuta kontot e-posti serveris.
remove-data-checkbox =
    .label = Eemaldatakse kirjad
    .accesskey = i
remove-chat-data-checkbox =
    .label = Eemaldatakse vestluste andmed
    .accesskey = v
remove-data-local-account-description = Eemaldab sinu kettalt kõik selle kontoga seotud kirjad, kaustad ja filtrid. See ei mõjuta mõnesid kirju, mida võidakse serveris säilitada. Ära vali seda valikut, kui kavatsed kohalikud andmed arhiveerida või neid hiljem { -brand-short-name }is uuesti kasutada.
remove-data-server-account-description = Eemaldab sinu kettalt kõik selle kontoga seotud kirjad, kaustad ja filtrid. Sinu kirju ja kaustu säilitatakse siiski serveris edasi.
remove-data-chat-account-description = Salvestuspinnalt kustutatakse kõigi selle kontoga seotud vestluste logid.
show-data-button =
    .label = Kuva andmete asukoht
    .accesskey = a
