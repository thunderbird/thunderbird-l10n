remove-account-dialog-title = Dilemel ar gont hag ar roadennoù
remove-account-dialog-accept =
    .label = Lemel
    .accesskey = L
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Ha fellout a ra deoc'h dilemel kuit ar gont "{ $accountName }" ?
remove-account-checkbox =
    .label = Lemel titouroù ar gont
    .accesskey = g
remove-account-description = Dilemel ar pezh a oa { -brand-short-name } diwar-benn ar gont-mañ nemetken. N'eus efed ebet war ar gont he-unan war an dafariad.
remove-data-checkbox =
    .label = Lemel roadennoù a gont
    .accesskey = g
remove-chat-data-checkbox =
    .label = Dilemel roadennoù ar gaozeadenn
    .accesskey = D
remove-data-local-account-description = Dilemel an holl gemennadennoù, teuliadoù ha siloù liammet gant ar gont-mañ eus ho kantenn lec'hel. Ne dizh ket kemennadennoù ’zo a c’hell bezañ lec’hiet war un dafariad. Na zibabit ket an dra-se ma fell deoc’h diellaouiñ ar roadennoù lec’hel pe ad-arverañ anezho e { -brand-short-name } diwezhatoc’h
remove-data-server-account-description = Dilemel an holl gemennadennoù, teuliadoù ha siloù liammet gant ar gont-mañ war ho kantenn lec'hel. Ho kemennadennoù hag ho teuliadoù a zo miret war an dafariad.
remove-data-chat-account-description = Dilemel an holl renabloù kaozeadennoù stoket evit ar gont-mañ war an disk lec'hel.
show-data-button =
    .label = Skrammañ lec'hiadur ar roadennoù
    .accesskey = S
