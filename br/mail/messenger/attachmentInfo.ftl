## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Enrollañ ar c'henstagadur
attachment-save-all-dialog-title = Enrollañ an holl genstagadurioù
attachment-detach-dialog-title = Distagañ ar c'henstagadennoù digantañ
attachment-detach-all-dialog-title = Distagañ an holl genstagadennoù digantañ
attachment-save-failed = N'hall ket enrollañ ar c'henstagadur. Gwiriit anv ho restr ha klaskit en-dro.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = { $filename } ez eus anezhañ endeo. E amsaviñ a fell deoc'h ?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Diverket da vat diouzh ar postel-mañ e vo ar c'henstagadurioù da heul :
    { $attachments }
    N'hallo ket bezañ nullet ar gwezh-mañ. Ha fellout a ra deoc'h kenderc'hel ?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Enrollet eo bet ar c'henstagadurioù da heul gant berzh ha diverket e vint da vat bremañ diouzh ar postel :
    { $attachments }
    N'hallo ket bezañ nullet ar gwezh-mañ. Ha fellout a ra deoc'h kenderc'hel ?
attachment-empty =
    Ar c'henstagadur-mañ zo goullo.
    Gwiriit gant kaser ar gemennadenn.
    Alies e vez distrujet ar c'henstagadurioù gant tanvogerioù pe diviruzerioù.
attachment-external-not-found = N'haller ket kavout ar restr distag pe ar stagadenn ere pe n'haller ket e haeziñ evit d'al lec'hiadur-mañ ken.
