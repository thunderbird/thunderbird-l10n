remove-account-dialog-title = Bain an cuntas agus sonraí a bhaineann leis
remove-account-dialog-accept =
    .label = Bain
    .accesskey = B
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = An bhfuil tú cinnte go dteastaíonn uait an cuntas "{ $accountName }" a bhaint?
remove-account-checkbox =
    .label = Bain faisnéis an chuntais
    .accesskey = a
remove-account-description = Bainfear an cuntas ó { -brand-short-name } amháin. Ní dhéanfar rud ar bith don chuntas ar an bhfreastalaí.
remove-data-checkbox =
    .label = Bain sonraí teachtaireachta
    .accesskey = s
remove-chat-data-checkbox =
    .label = Scrios na sonraí comhrá
    .accesskey = c
remove-data-local-account-description = Scriosann an rogha seo na teachtaireachtaí, na fillteáin, agus na scagairí go léir a bhaineann leis an gcuntas seo ar do dhiosca áitiúil. Ní rachaidh sé i bhfeidhm ar na teachtaireachtaí atá fós ar an bhfreastalaí. Ná húsáid an rogha seo má tá tú ag iarraidh na sonraí áitiúla a chur i gcartlann nó iad a úsáid in { -brand-short-name } ar ball.
remove-data-server-account-description = Scriosann an rogha seo na teachtaireachtaí, na fillteáin, agus na scagairí go léir a bhaineann leis an gcuntas seo ar do dhiosca áitiúil. Ní scriosfar na teachtaireachtaí agus na fillteáin atá agat ar an bhfreastalaí.
remove-data-chat-account-description = Scriosann seo gach taifead ar chomhrá a bhaineann leis an gcuntas seo ón diosca áitiúil.
show-data-button =
    .label = Taispeáin suíomh na sonraí
    .accesskey = s
