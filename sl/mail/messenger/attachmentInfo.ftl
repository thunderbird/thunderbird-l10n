## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Shrani priponko
attachment-save-all-dialog-title = Shrani vse priponke
attachment-detach-dialog-title = Odpni priponko
attachment-detach-all-dialog-title = Odpni vse priponke
attachment-save-failed = Priponke ni mogoče shraniti. Preverite ime svoje datoteke in poskusite znova kasneje.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = { $filename } že obstaja. Ali jo želite zamenjati?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Naslednje priponke bodo za vedno izbrisane iz tega sporočila:
    { $attachments }
    Tega dejanja ni mogoče razveljaviti. Želite nadaljevati?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Naslednje priponke so bile uspešno shranjene, zdaj pa bodo za vedno izbrisane iz tega sporočila:
    { $attachments }
    Tega dejanja se ne da razveljaviti. Ali želite nadaljevati?
attachment-empty =
    To priponka se zdi prazna.
    Obrnite se na osebo, ki vam jo je poslala.
    Požarni zidovi v podjetjih ali protivirusni programi priponke pogosto uničijo.
attachment-external-not-found = Ta ločena datoteka ali priloga povezave ni več na voljo ali ni več dostopna na tej lokaciji.
