## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Lagre vedlegg
attachment-save-all-dialog-title = Lagre alle vedlegg
attachment-detach-dialog-title = Løsne vedlegg
attachment-detach-all-dialog-title = Løsne alle vedlegg
attachment-save-failed = Klarte ikke lagre vedlegget. Kontroller filnavnet og prøv igjen.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = { $filename } finnes allerede. Vil du erstatte den?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Følgende vedlegg slettes nå permanent fra denne meldingen:
    { $attachments }
    Denne handlingen kan ikke omgjøres. Vil du fortsette?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Følgende vedlegg er lagret, og slettes nå permanent fra meldingen:
    { $attachments }
    Denne handlingen kan ikke omgjøres. Vil du fortsette?
attachment-empty =
    Dette vedlegget ser ut til å være tomt.
    Kontroller med personen som sendte det.
    Firmabrannmurer eller antivirusprogrammer kan ofte ødelegge vedlegg.
attachment-external-not-found = Denne fraskillte fil eller lenke finnes ikke, eller den kan ikke lengre åpnes på dette stedet lenger.
