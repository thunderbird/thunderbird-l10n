remove-account-dialog-title = Konto a daty wótpóraś
remove-account-dialog-accept =
    .label = Wótpóraś
    .accesskey = W
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Cośo konto "{ $accountName }" napšawdu wótpóraś?
remove-account-checkbox =
    .label = Kontowe daty wótpóraś
    .accesskey = o
remove-account-description = Wótpórajo jano wědu { -brand-short-name } wó toś tom konśe. Njewobwliwujo konto same wó serwerje.
remove-data-checkbox =
    .label = Powěsćowe daty wótpóraś
    .accesskey = d
remove-chat-data-checkbox =
    .label = Rozgronowe daty wótwónoźeś
    .accesskey = d
remove-data-local-account-description = Wótpórajo wšykne powěsći, zarědniki a filtry zwěazane z toś tym kontom z wašeje lokalneje platy. To njewobwliwujo někotare powěsći, kótarež maju na serwerje wóstaś. Njewuběrajśo to, jolic cośo lokalne daty archiwěrowaś abo pózdźej w { -brand-short-name } zasej wužywaś.
remove-data-server-account-description = Wótpórajo wšykne powěsći, zarědniki a filtry zwězane z toś tym kontom z wašeje lokalneje platy. Waše powěsći a zarědniki wóstanu hyšći na wašom serwerje.
remove-data-chat-account-description = Wótwónoźijo wše protokole rozgronow skłaźone za toś to konto na lokalnej plaśe.
show-data-button =
    .label = Městno datow pokazaś
    .accesskey = M
# Variables:
# $count (Number) - The number of outgoing servers to be removed.
remove-outgoing-servers-checkbox =
    .label =
        { $count ->
            [one] { $count } wuchadny serwer wótwónoźeś
            [two] { $count } wuchadnej serwera wótwónoźeś
            [few] { $count } wuchadne serwery wótwónoźeś
           *[other] { $count } wuchadnych serwerow wótwónoźeś
        }
# Variables:
# $count (Number) - The number of address books to be removed.
