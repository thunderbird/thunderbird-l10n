remove-account-dialog-title = Retirar a conta e os datos
remove-account-dialog-accept =
    .label = Retirar
    .accesskey = R
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = Confirma que quere retirar a conta «{ $accountName }»?
remove-account-checkbox =
    .label = Retirar a información da conta
    .accesskey = a
remove-account-description = Retirar unicamente a conta do { -brand-short-name }. Isto non afecta á conta que está no servidor.
remove-data-checkbox =
    .label = Retirar os datos da mensaxe
    .accesskey = d
remove-chat-data-checkbox =
    .label = Retirar os datos da conversa
    .accesskey = d
remove-data-local-account-description = Retira do disco local todas as mensaxes, cartafoles e filtros asociados con esta conta. Isto non afectará a algunhas mensaxes que aínda poden conservarse no servidor. Non seleccione isto se planea arquivar os datos locais ou reutilizalos no { -brand-short-name } máis adiante.
remove-data-server-account-description = Retira do seu disco local todas as mensaxes, cartafoles e filtros asociados con esta conta. As mensaxes e cartafoles seguirán no servidor.
remove-data-chat-account-description = Retira todos os rexistros desta conta almacenados no seu disco local.
show-data-button =
    .label = Amosar a localización dos datos
    .accesskey = S
