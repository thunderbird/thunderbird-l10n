remove-account-dialog-title = احذف الحساب و البيانات
remove-account-dialog-accept =
    .label = احذف
    .accesskey = ح
# Variables:
# $accountName (String) - The name of the account to be removed.
remove-account-question = أمتأكد أنك تريد حذف الحساب ”{ $accountName }“؟
remove-account-checkbox =
    .label = احذف معلومات الحساب
    .accesskey = ح
remove-account-description = احذف ما يعرفه { -brand-short-name } عن هذه الحساب. لا يؤثر في الحساب نفسه على الخادوم.
remove-data-checkbox =
    .label = احذف بيانات الرسائل
    .accesskey = ن
remove-chat-data-checkbox =
    .label = احذف بيانات المحادثة
    .accesskey = ن
remove-data-local-account-description = يحذف كل الرسائل و المجلدات و المرشحات المرتبطة بهذا الحساب من على قرصك المحلي. لا يؤثر هذا في الرسائل الموجودة على الخادوم. لا تستخدم هذا إن كنت تخطط لأرشفة البيانات المحلية أو إعادة استخدامها في { -brand-short-name }.
remove-data-server-account-description = يحذف كل الرسائل و المجلدات و المرشحات المرتبطة بهذا الحساب من على قرصك المحلي. رسائلك و مجلداتك لن تُحذف من على الخادوم.
remove-data-chat-account-description = يحذف كل سجلات المحادثات المحفوظة لهذا الحساب على حاسوبك.
show-data-button =
    .label = اعرض مكان البيانات
    .accesskey = ع
