## Strings used by attachment actions: saving, opening, detaching and deleting.

attachment-save-dialog-title = Gorde eranskina
attachment-save-all-dialog-title = Gorde eranskin guztiak
attachment-detach-dialog-title = Kendu eranskina
attachment-detach-all-dialog-title = Kendu eranskin guztiak
attachment-save-failed = Ezin da eranskina gorde. Egiaztatu fitxategi-izena eta saiatu geroago.
# Variables:
#   $filename (String) - Name of the file that already exists.
attachment-file-exists = { $filename } badago lehendik. Ordeztu nahi duzu?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-delete-confirm =
    Hurrengo eranskinak betirako ezabatuko dira mezu honetatik:
    { $attachments }
    Ekintza hau ezin da desegin. Jarraitu egin nahi duzu?
# Variables:
#   $attachments (String) - Newline separated list of attachment names.
attachment-detach-confirm =
    Hurrengo eranskinak ondo gorde dira eta betirako ezabatuko dira orain mezu honetatik:
    { $attachments }
    Ekintza hau ezin da desegin. Jarraitu egin nahi duzu?
attachment-empty =
    Eranskin hau hutsa dagoela dirudi.
    Egiaztatu hau bidali duen pertsonarekin.
    Enpresetako suebakiek edo antibirus-programek eranskinak suntsitzen dituzten maiz.
attachment-external-not-found = Askatutako fitxategia edo eranskinaren lotura ez da aurkitzen edo ezin da atzitu kokapen honetan gehiago.
